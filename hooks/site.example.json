{
  "hub_url": "http://192.168.1.50:8787",
  "hub_ssh": "user@hub-box",
  "hub_tokens": "~/agenthub/data/tokens.json",
  "humans": [
    "human@hub"
  ],
  "hosts": [
    {
      "pattern": "^my-desktop$",
      "host": "desk"
    },
    {
      "pattern": "^build(\\d+)$"
    }
  ],
  "spawn": {
    "vendors": [
      "claude",
      "codex"
    ],
    "max": 3,
    "permission_mode": "auto",
    "cwd": {
      "desk": "C:/Dev",
      "*": "~"
    },
    "anyone": {
      "*": "claude"
    }
  },
  "shared_folder": "\\\\fileserver\\share\\Agents"
}